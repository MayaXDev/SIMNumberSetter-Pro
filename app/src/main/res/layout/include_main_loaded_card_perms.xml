<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/surface_cyber"
    style="@style/Widget.Material3.CardView.Filled">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_key"
                app:tint="@color/neon_cyan" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="PRO PRIVILEGES &amp; PERMISSIONS"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:fontFamily="@font/google_sans_text_bold"
                android:textColor="@color/neon_cyan" />

            <TextView
                android:id="@+id/perm_summary_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/neon_green" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Permission 1: Phone State -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_perm_phone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Telephony &amp; SIM Hardware Access"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/status_perm_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Granted"
                    android:textSize="11sp"
                    android:fontFamily="@font/google_sans_text_bold"
                    android:textColor="@color/neon_green" />

            </LinearLayout>

            <!-- Permission 2: Telephony Dump / Direct Hook -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_perm_dump"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Direct Telephony Debug Interface"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/status_perm_dump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Granted"
                    android:textSize="11sp"
                    android:fontFamily="@font/google_sans_text_bold"
                    android:textColor="@color/neon_green" />

            </LinearLayout>

            <!-- Permission 3: Root Privilege -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_perm_root"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="APatch / KernelSU / Magisk SU"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/status_perm_root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="11sp"
                    android:fontFamily="@font/google_sans_text_bold"
                    android:textColor="@color/neon_green" />

            </LinearLayout>

            <!-- Permission 4: LSPosed Scope Check -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_perm_lsposed"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/neon_amber" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="LSPosed Scope (Phone &amp; Framework)"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/status_perm_lsposed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Optional (Root OK)"
                    android:textSize="11sp"
                    android:fontFamily="@font/google_sans_text_bold"
                    android:textColor="@color/neon_cyan" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_auto_grant_perms"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_key"
            app:iconTint="@color/neon_cyan"
            app:iconGravity="textStart"
            app:backgroundTint="@color/surface_cyber_elevated"
            app:strokeColor="@color/neon_cyan"
            app:strokeWidth="1dp"
            android:textColor="@color/neon_cyan"
            android:fontFamily="@font/google_sans_text_bold"
            android:text="Auto-Grant All Permissions (1-Click)" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
